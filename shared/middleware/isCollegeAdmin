const isCollegeAdmin = (req, res, next) => {
  if (!req.user) {
    return res.status(401).json({
      success: false,
      message: "Unauthorized",
    });
  }

  if (req.user.role !== "college-admin") {
    return res.status(403).json({
      success: false,
      message: "College Admin access only",
    });
  }

  next();
};

module.exports = isCollegeAdmin;
